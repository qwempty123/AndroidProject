<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/space_12">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/courseCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/course_surface"
        app:cardCornerRadius="@dimen/radius_18"
        app:cardElevation="0dp"
        app:strokeColor="@color/course_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_14">

            <TextView
                android:id="@+id/courseCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_course_chip"
                android:paddingHorizontal="@dimen/space_10"
                android:paddingVertical="@dimen/space_6"
                android:textColor="@color/course_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/courseIcon"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/courseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:maxLines="2"
                android:textColor="@color/course_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/courseIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseCategory" />

            <TextView
                android:id="@+id/courseAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/course_text_secondary"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseTitle" />

            <TextView
                android:id="@+id/courseDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:maxLines="3"
                android:textColor="@color/course_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseAuthor" />

            <TextView
                android:id="@+id/courseMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:textColor="@color/course_accent"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseDescription" />

            <TextView
                android:id="@+id/coursePrice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:textColor="@color/course_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/courseFavorite"
                app:layout_constraintEnd_toStartOf="@id/courseFavorite"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/courseFavorite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/courseFavorite"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_12"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="♡"
                android:textSize="18sp"
                app:cornerRadius="@dimen/radius_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseMeta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/courseAction"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/space_8"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/course_add_to_cart"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_12"
                app:layout_constraintBottom_toBottomOf="@id/courseFavorite"
                app:layout_constraintEnd_toStartOf="@id/courseFavorite"
                app:layout_constraintTop_toTopOf="@id/courseFavorite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/courseDetails"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/course_details"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/courseFavorite" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
